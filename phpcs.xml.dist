<?xml version="1.0"?>
<ruleset name="AI Provider for OpenAI Compatible Servers">
    <description>PSR-12 formatting (matching the WordPress AI Client SDK style) plus WordPress security, i18n, and escaping sniffs.</description>

    <file>plugin.php</file>
    <file>includes</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/scratch/*</exclude-pattern>

    <arg value="ps"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- Base formatting: PSR-12, as used by the WordPress AI Client SDK. -->
    <rule ref="PSR12"/>

    <!-- The plugin bootstrap and autoloader legitimately mix declarations and side effects. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>plugin\.php$</exclude-pattern>
        <exclude-pattern>includes/autoload\.php$</exclude-pattern>
    </rule>

    <!-- WordPress-specific correctness and security sniffs. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ai-provider-for-openai-compatible-servers"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.DateTime.RestrictedFunctions"/>

    <!-- PHP cross-version compatibility, per the plugin header. -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.9"/>
</ruleset>
